### 대여 주문 생성 - 직접 결제 (productId, color)
# POST /api/v1/rentals
# Authorization 헤더에 Access Token을 담아 요청해야 합니다.
# productId와 color로 바로 대여 결제 및 주문을 생성합니다.
POST http://localhost:8080/api/v1/rentals
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "productId": 1,
  "color": "BLACK",
  "rentStartAt": "2025-09-15",
  "rentEndAt": "2025-09-20",
  "shippingInfo": {
    "receiver": "홍길동",
    "phoneNumber": "010-1234-5678",
    "address": {
      "postcode": "12345",
      "postAddress": "서울시 강남구 테헤란로 123",
      "detailAddress": "456호"
    }
  },
  "paymentMethod": "KAKAO_PAY"
}

### 대여 주문 생성 - 장바구니 결제 (cartIds)
# POST /api/v1/rentals
# Authorization 헤더에 Access Token을 담아 요청해야 합니다.
# cartIds 목록으로 장바구니에서 대여 주문을 생성합니다.
POST http://localhost:8080/api/v1/rentals
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "cartIds": [
    1,
    2
  ],
  "rentStartAt": "2025-09-15",
  "rentEndAt": "2025-09-22",
  "shippingInfo": {
    "receiver": "김철수",
    "phoneNumber": "010-9876-5432",
    "address": {
      "postcode": "54321",
      "postAddress": "부산시 해운대구 해운대로 456",
      "detailAddress": "789호"
    }
  },
  "paymentMethod": "CREDIT_CARD"
}

### 대여 주문 생성 - 여러 장바구니 아이템
# POST /api/v1/rentals
# 장바구니에 여러 상품이 담겨 있을 때 한 번에 대여 주문
POST http://localhost:8080/api/v1/rentals
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "cartIds": [
    1,
    2,
    3
  ],
  "rentStartAt": "2025-09-16",
  "rentEndAt": "2025-09-25",
  "shippingInfo": {
    "receiver": "이영희",
    "phoneNumber": "010-5555-6666",
    "address": {
      "postcode": "67890",
      "postAddress": "대구시 중구 동성로 789",
      "detailAddress": "101동 202호"
    }
  },
  "paymentMethod": "TOSS_PAY"
}

### 대여 주문 생성 - 실패 케이스 (둘 다 있음)
# POST /api/v1/rentals
# productId와 cartIds가 모두 있는 애매한 요청
POST http://localhost:8080/api/v1/rentals
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "productId": 1,
  "color": "BLACK",
  "cartIds": [
    1,
    2
  ],
  "rentStartAt": "2025-09-15",
  "rentEndAt": "2025-09-20",
  "shippingInfo": {
    "receiver": "홍길동",
    "phoneNumber": "010-1234-5678",
    "address": {
      "postcode": "12345",
      "postAddress": "서울시 강남구 테헤란로 123",
      "detailAddress": "456호"
    }
  },
  "paymentMethod": "KAKAO_PAY"
}

### 상품 단건 조회
GET http://localhost:8080/api/v1/rentals/1
Authorization: Bearer {{accessToken}}

### 상품 목록 조회
GET http://localhost:8080/api/v1/rentals
Authorization: Bearer {{accessToken}}

### 총 대여 수 및 총 환급 금액 조회
GET http://localhost:8080/api/v1/rentals/count
Authorization: Bearer {{accessToken}}

### 결제 정보 조회
GET http://localhost:8080/api/v1/rentals/1/payment
Authorization: Bearer {{accessToken}}